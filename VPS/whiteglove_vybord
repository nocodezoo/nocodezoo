      <h4 id="modalTitle"></h4>
      <p id="modalSub"></p>
    </div>
  </div>
</div>

<script>
function openModal(src, title, sub) {
  var modal = document.getElementById('videoModal');
  var vid = document.getElementById('modalVideo');
  document.getElementById('modalTitle').textContent = title;
  document.getElementById('modalSub').textContent = sub;
  vid.src = src;
  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
  vid.play().catch(function(){});
}
function closeModal() {
  var vid = document.getElementById('modalVideo');
  vid.pause(); vid.src = '';
  document.getElementById('videoModal').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if(e.key==='Escape') closeModal(); });
document.getElementById('videoModal').addEventListener('click', function(e) {
  if(e.target === this) closeModal();
});
</script>

<!-- SCROLL FADE-IN OBSERVER -->
<script>
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  var fadeTargets = [
    '.hero-badge', '.hero h1', '.hero-sub',
    '.hero-actions', '.hero-note', '.demo-videos',
    '.social-proof', '.section-label', '.section-title',
    '.section-sub'
  ];

  // Hero children
  document.querySelectorAll('.hero > *').forEach(function(el) {
    if (!el.classList.contains('demo-videos')) {
      el.classList.add('fade-in-section');
    }
  });

  // Cards & items
  document.querySelectorAll('.step-card, .feature-card, .plan-card, .faq-item').forEach(function(el) {
    el.classList.add('fade-in-section');
  });

  // Section headers (per container)
  document.querySelectorAll('.section .section-label, .section .section-title, .section .section-sub').forEach(function(el) {
    el.classList.add('fade-in-section');
  });

  // CTA section
  document.querySelectorAll('.cta-section > *').forEach(function(el) {
    el.classList.add('fade-in-section');
  });

  // Observe all marked elements
  document.querySelectorAll('.fade-in-section').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>
