def send_video_email(broker_email: str, listing: dict, video_path_or_url: str):
    """Send the video + pitch to the broker."""
    msg = MIMEMultipart()
    msg["From"] = EMAIL_SENDER
    msg["To"] = broker_email
    msg["Subject"] = f"Free Custom Video for {listing.get('address')} – Let's Get It Sold Faster"

    body = create_email_body(listing, video_path_or_url)
    msg.attach(MIMEText(body, "plain"))

    # If video is a local file, attach it; otherwise just link it
    if video_path_or_url.startswith("http"):
        # Video is hosted – just use the link (already in body)
        pass
    else:
        # Attach the actual video file
        with open(video_path_or_url, "rb") as f:
            part = MIMEBase("application", "octet-stream")
            part.set_payload(f.read())
            encoders.encode_base64(part)
            part.add_header("Content-Disposition", f"attachment; filename=video_{listing.get('listing_id')}.mp4")
            msg.attach(part)

    try:
        with smtplib.SMTP_SSL(EMAIL_SMTP_SERVER, 465) as server:
            server.login(EMAIL_SENDER, EMAIL_PASSWORD)
            server.send_message(msg)
        logging.info(f"Email sent successfully to {broker_email} for listing {listing.get('address')}")
        print(f"✅ Email sent to {broker_email}")
    except Exception as e:
        logging.error(f"Failed to send email to {broker_email}: {e}")
        print(f"❌ Email failed for {broker_email}")


# ========================= MAIN AGENT LOOP =========================

def run_claw():
    """Main execution loop for Claw – your AI agent."""
    print("🚀 Claw AI Agent started – Stale Listing Video Outreach")
    logging.info("Claw AI Agent started")

    brokers = load_broker_list(BROKER_CSV_PATH)

    for _, row in brokers.iterrows():
        brokerage = row["brokerage_name"]
        email = row["email"]

        print(f"\n🔍 Processing brokerage: {brokerage}")

        # Step 1: Identify stale MLS listings for this brokerage
        stale_listings = get_stale_listings_for_brokerage(brokerage)

        for listing in stale_listings:
            # Step 2: Enrich with images & full details from the website you identified
            listing = fetch_listing_details(listing)

            # Step 3: Trigger the video pipeline (voice-over + script + captions + music + motion)
            video_path_or_url = trigger_video_pipeline(listing)
            if not video_path_or_url:
                continue

            # Step 4: Email the video + partnership proposal to the broker
            send_video_email(email, listing, video_path_or_url)

            # Polite delay to respect email sending limits
            time.sleep(5)

    print("\n🎉 Claw AI Agent completed run. Check claw_logs_*.log for details.")
    logging.info("Claw AI Agent completed run")


# ========================= RUN THE AGENT =========================
if __name__ == "__main__":
    run_claw()
