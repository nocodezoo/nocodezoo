def load_broker_list(csv_path: str) -> pd.DataFrame:
    """Load the broker email list."""
    df = pd.read_csv(csv_path)
    required_cols = {"brokerage_name", "email"}
    if not required_cols.issubset(df.columns):
        raise ValueError(f"CSV must contain columns: {required_cols}")
    logging.info(f"Loaded {len(df)} brokers from {csv_path}")
    return df


def get_stale_listings_for_brokerage(brokerage_name: str, days_threshold: int = 150, limit: int = 1) -> list[dict]:
    """
    Query MLS (or scrape the specific website you identify) for listings belonging to this brokerage
    that have been on market > days_threshold.
    Returns a list of listing dicts (max 'limit' per run to avoid spam).
    """
    # TODO: Replace this placeholder with your real MLS integration
    # Example options:
    # 1. Official MLS API / RETS / Bridge Interactive / RESO Web API
    # 2. Authorized data feed you already have access to
    # 3. If only public site scraping is possible, use Selenium + your login (but NOT recommended for production)

    payload = {
        "brokerage": brokerage_name,
        "days_on_market_min": days_threshold,
        "limit": limit,
        "fields": "listing_id,address,price,description,days_on_market,photo_urls,listing_url,listing_agent"
    }

    try:
        # Example API call (replace with your real endpoint)
        response = requests.post(
            f"{MLS_API_BASE_URL}/search",
            json=payload,
            timeout=30
        )
        response.raise_for_status()
        listings = response.json().get("listings", [])

        # Fallback: if you want Claw to visit the exact website you identify
        # (uncomment and adapt if you prefer scraping the site you specified)
        # for listing in listings:
        #     if "listing_url" not in listing or not listing["listing_url"]:
        #         listing["listing_url"] = f"{SPECIFIC_MLS_WEBSITE}/{listing['listing_id']}"

        logging.info(f"Found {len(listings)} stale listings for {brokerage_name}")
        return listings

    except Exception as e:
        logging.error(f"Failed to fetch listings for {brokerage_name}: {e}")
        return []


def fetch_listing_details(listing: dict) -> dict:
    """Enrich listing with images and full info from the specific website you identify."""
    # If your MLS API already returns everything, you can skip this step.
    # Otherwise, Claw visits the listing_url and extracts images + data.
    if not listing.get("listing_url"):
        return listing

    try:
        # Example: simple GET + parsing (replace with your authenticated scraper or API)
        resp = requests.get(listing["listing_url"], timeout=15)
        # In production you would use BeautifulSoup or your MLS data feed here
        # For now we assume the API already gave us photo_urls
        logging.info(f"Successfully pulled details & images for {listing.get('address')}")
    except Exception as e:
        logging.warning(f"Could not enrich listing {listing.get('listing_id')}: {e}")

    return listing


def trigger_video_pipeline(listing: dict) -> str | None:
    """
    Calls your existing video pipeline.
    The pipeline should automatically:
      - Generate a compelling voice-over script from the listing data
      - Add captions
      - Layer background music
      - Apply motion/graphics
      - Return a downloadable video file path or public URL
    """
    payload = {
        "listing_data": listing,
        "style": "real-estate-showcase",   # Customize as needed
        "voice": "professional-realtor",   # Your preferred voice
        "duration_target": 60,             # seconds
        "include_motion": True,
        "include_captions": True,
        "music_track": "upbeat-modern"
    }

    try:
        response = requests.post(
            VIDEO_PIPELINE_API_URL,
            json=payload,
            timeout=300  # 5-minute timeout for video generation
        )
        response.raise_for_status()
        video_path_or_url = response.json().get("video_path") or response.json().get("video_url")

        logging.info(f"Video pipeline triggered successfully for {listing.get('address')}")
        return video_path_or_url

    except Exception as e:
        logging.error(f"Video pipeline failed for {listing.get('address')}: {e}")
        return None


