### Python Code Skeleton (Diffusers)

```python
import torch
from diffusers import StableVideoDiffusionPipeline
from diffusers.utils import load_image, export_to_video

pipe = StableVideoDiffusionPipeline.from_pretrained(
    "stabilityai/stable-video-diffusion-img2vid-xt",
    torch_dtype=torch.float16,
    variant="fp16"
)
pipe.enable_model_cpu_offload()   # Use if VRAM < 16GB
pipe.unet.enable_forward_chunking()

# Load and resize your dining room image
image = load_image("dining_room.jpg")
image = image.resize((1024, 576))

generator = torch.manual_seed(42)  # Fix seed for reproducibility

frames = pipe(
    image,
    num_frames=25,
    num_inference_steps=30,
    decode_chunk_size=8,
    motion_bucket_id=40,        # SLOW cinematic motion
    noise_aug_strength=0.02,    # High fidelity to input
    min_guidance_scale=1.0,
    max_guidance_scale=3.0,
    fps=7,
    generator=generator,
).frames[0]

export_to_video(frames, "drone_dining_room.mp4", fps=7)
```

