def merge_group(records: List[Listing]) -> Dict[str, Any]:
    best = sorted(records, key=completeness_score, reverse=True)[0]

    merged = asdict(best)
    merged["sources"] = [r.source_url for r in records]
    merged["source_names"] = sorted(list(set(r.source_name for r in records)))

    merged["image_urls"] = list(dict.fromkeys(
        url for r in records for url in r.image_urls if url
    ))
    merged["video_urls"] = list(dict.fromkeys(
        url for r in records for url in r.video_urls if url
    ))
    merged["features"] = sorted(list(set(
        feature for r in records for feature in r.features if feature
    )))

Fill missing scalar fields from other records
    scalar_fields = [
        "external_id", "mls_id", "address", "city", "state", "postal_code",
        "lat", "lon", "price", "beds", "baths", "sqft", "lot_sqft",
        "property_type", "status", "description", "broker_name", "agent_name"
    ]
    for field_name in scalar_fields:
        if merged.get(field_name) in (None, "", []):
            for r in records:
                value = getattr(r, field_name)
                if value not in (None, "", []):
                    merged[field_name] = value
                    break

    merged["merged_at"] = now_iso()
    return merged

def build_canonical(listings: List[Listing]) -> Dict[str, Dict[str, Any]]:
    groups: Dict[str, List[Listing]] = {}
    for listing in listings:
        key = dedupe_key(listing)
        groups.setdefault(key, []).append(listing)
    return {key: merge_group(items) for key, items in groups.items()}

