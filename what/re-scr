def format_search_url(template: str, query: Dict[str, Any]) -> str:
    fmt = dict(query)
    fmt["city_slug"] = slugify(query.get("city", ""))
    fmt["state_slug"] = slugify(query.get("state", ""))
    return template.format(**fmt)

def scrape_site(fetcher: Fetcher, site_cfg: Dict[str, Any], query: Dict[str, Any], max_per_site: int) -> List[Listing]:
    source_name = site_cfg["name"]
    render_js = site_cfg.get("render_js", False)
    wait_ms = int(site_cfg.get("wait_ms", 1500))
    search_urls = [format_search_url(t, query) for t in site_cfg.get("search_urls", [])]
    found: List[Listing] = []

    for search_url in search_urls:
        user_agent = fetcher.session.headers.get("User-Agent", "*")
        if not allowed_by_robots(site_cfg["home_url"], search_url, user_agent):
            print(f"[SKIP] robots.txt disallows search URL for {source_name}: {search_url}")
            continue

        html = fetcher.fetch(search_url, render_js=render_js, wait_ms=wait_ms)
        if not html:
            continue

        soup = BeautifulSoup(html, "lxml")
        links = discover_listing_links(soup, site_cfg, search_url)

        for link in links[:max_per_site]:
            if not allowed_by_robots(site_cfg["home_url"], link, user_agent):
                print(f"[SKIP] robots.txt disallows listing URL for {source_name}: {link}")
                continue

            page_html = fetcher.fetch(link, render_js=render_js, wait_ms=wait_ms)
            if not page_html:
                continue

            page_soup = BeautifulSoup(page_html, "lxml")
            listing = parse_listing_page(page_soup, site_cfg, link, source_name)
            if listing:
                listing.source_search_url = search_url
                found.append(listing)

            time.sleep(site_cfg.get("delay_seconds", 1.0))

    return found

