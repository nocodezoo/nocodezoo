def main():
    parser = argparse.ArgumentParser(description="Real estate multi-source listing aggregator")
    parser.add_argument("--sites", required=True, help="Path to sites.yaml")
    parser.add_argument("--db", default="listings.db", help="SQLite DB path")
    parser.add_argument("--city", required=True)
    parser.add_argument("--state", required=True)
    parser.add_argument("--postal-code", default="")
    parser.add_argument("--min-price", type=int, default=0)
    parser.add_argument("--max-price", type=int, default=0)
    parser.add_argument("--beds", type=int, default=0)
    parser.add_argument("--max-per-site", type=int, default=20)
    parser.add_argument("--download-media", action="store_true")
    parser.add_argument("--media-dir", default="media")
    args = parser.parse_args()

    with open(args.sites, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f)

    headers = cfg.get("default_headers", {
        "User-Agent": "ListingAggregatorBot/1.0 (+contact@example.com)"
    })
    fetcher = Fetcher(headers=headers, timeout=30)
    storage = Storage(args.db)

    query = {
        "city": args.city,
        "state": args.state,
        "postal_code": args.postal_code,
        "min_price": args.min_price,
        "max_price": args.max_price,
        "beds": args.beds
    }

    all_records: List[Listing] = []

    for site_cfg in cfg.get("sites", []):
        print(f"\n=== Scraping {site_cfg['name']} ===")
        try:
            records = scrape_site(fetcher, site_cfg, query, args.max_per_site)
            print(f"[INFO] {site_cfg['name']} -> {len(records)} listings")
            for rec in records:
                storage.save_source(rec)
            all_records.extend(records)
        except Exception as e:
            print(f"[ERROR] {site_cfg['name']} failed -> {e}")

    canonical = build_canonical(all_records)
    for key, payload in canonical.items():
        storage.save_canonical(key, payload)

    if args.download_media:
        download_media(fetcher, canonical, args.media_dir)

    print(f"\nDone.")
    print(f"Source records: {len(all_records)}")
    print(f"Canonical listings: {len(canonical)}")
    print(f"DB: {args.db}")

if name == "main":
    main()

