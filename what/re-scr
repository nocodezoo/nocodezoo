ROBOTS_CACHE: Dict[str, RobotFileParser] = {}

def slugify(text: str) -> str:
    text = text.strip().lower()
    text = re.sub(r"+", "-", text)
    return text.strip("-")

def clean_text(value: Optional[str]) -> Optional[str]:
    if not value:
        return None
    value = re.sub(r"\s+", " ", value).strip()
    return value or None

def parse_num(value: Any) -> Optional[float]:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return float(value)
    s = str(value).replace(",", "")
    m = re.search(r"(-?\d+(?:\.\d+)?)", s)
    return float(m.group(1)) if m else None

def parse_money(value: Any) -> Optional[float]:
    return parse_num(value)

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()

def dedupe_key(listing: Listing) -> str:
    if listing.mls_id:
        return f"mls:{listing.mls_id}".lower()
    parts = [
        (listing.address or "").lower().strip(),
        (listing.city or "").lower().strip(),
        (listing.state or "").lower().strip(),
        (listing.postal_code or "").lower().strip(),
    ]
    joined = "|".join(parts)
    return "addr:" + hashlib.sha256(joined.encode("utf-8")).hexdigest()

def completeness_score(l: Listing) -> int:
    score = 0
    fields = [
        l.address, l.city, l.state, l.postal_code, l.price, l.beds, l.baths,
        l.sqft, l.description, l.property_type, l.status, l.broker_name,
        l.agent_name, l.lat, l.lon
    ]
    score += sum(1 for x in fields if x not in (None, "", []))
    score += len(l.image_urls)
    score += len(l.video_urls) * 2
    score += len(l.features)
    return score

def get_robot_parser(base_url: str) -> RobotFileParser:
    parsed = urlparse(base_url)
    origin = f"{parsed.scheme}://{parsed.netloc}"
    if origin in ROBOTS_CACHE:
        return ROBOTS_CACHE[origin]
    rp = RobotFileParser()
    rp.set_url(urljoin(origin, "/robots.txt"))
    try:
        rp.read()
    except Exception:
        pass
    ROBOTS_CACHE[origin] = rp
    return rp

def allowed_by_robots(base_url: str, target_url: str, user_agent: str) -> bool:
    try:
        rp = get_robot_parser(base_url)
        return rp.can_fetch(user_agent, target_url)
    except Exception:
        return True

def first_text(soup: BeautifulSoup, selectors: List[str]) -> Optional[str]:
    for sel in selectors or []:
        node = soup.select_one(sel)
        if node:
            text = clean_text(node.get_text(" ", strip=True))
            if text:
                return text
    return None

def all_attrs(soup: BeautifulSoup, selectors: List[str], attr: str) -> List[str]:
    values = []
    for sel in selectors or []:
        for node in soup.select(sel):
            value = node.get(attr)
            if value:
                values.append(value.strip())
    return list(dict.fromkeys(values))

def extract_jsonld_objects(soup: BeautifulSoup) -> List[Dict[str, Any]]:
    objects = []
    for script in soup.find_all("script", attrs={"type": "application/ld+json"}):
        raw = script.string or script.get_text()
        if not raw:
            continue
        try:
            data = json.loads(raw)
        except Exception:
            continue
        if isinstance(data, dict):
            objects.append(data)
        elif isinstance(data, list):
            objects.extend([x for x in data if isinstance(x, dict)])
    return objects

def flatten_jsonld(data: Dict[str, Any]) -> List[Dict[str, Any]]:
    out = []

    def walk(obj: Any):
        if isinstance(obj, dict):
            out.append(obj)
            for v in obj.values():
                walk(v)
        elif isinstance(obj, list):
            for item in obj:
                walk(item)

    walk(data)
    return out

def listing_from_jsonld(obj: Dict[str, Any], source_name: str, url: str) -> Optional[Listing]:
    flat = flatten_jsonld(obj)
    best = None
    for node in flat:
        node_type = node.get("@type")
        if isinstance(node_type, list):
            node_type = " ".join(node_type)

        has_address = "address" in node
        has_offer = "offers" in node or "price" in node
        has_image = "image" in node

        if has_address or has_offer or has_image:
            best = node
            break

    if not best:
        return None

    address = best.get("address")
    street = city = state = postal = None
    if isinstance(address, dict):
        street = address.get("streetAddress")
        city = address.get("addressLocality")
        state = address.get("addressRegion")
        postal = address.get("postalCode")
    elif isinstance(address, str):
        street = address

    offers = best.get("offers", {})
    if isinstance(offers, list) and offers:
        offers = offers[0]
    if not isinstance(offers, dict):
        offers = {}

    images = []
    image_field = best.get("image")
    if isinstance(image_field, str):
        images = [image_field]
    elif isinstance(image_field, list):
        images = [x for x in image_field if isinstance(x, str)]
    elif isinstance(image_field, dict) and image_field.get("url"):
        images = [image_field["url"]]

    videos = []
    video_field = best.get("video")
    if isinstance(video_field, str):
        videos = [video_field]
    elif isinstance(video_field, list):
        for item in video_field:
            if isinstance(item, str):
                videos.append(item)
            elif isinstance(item, dict) and item.get("contentUrl"):
                videos.append(item["contentUrl"])
            elif isinstance(item, dict) and item.get("url"):
                videos.append(item["url"])

    return Listing(
        source_name=source_name,
        source_url=url,
        external_id=best.get("@id") or best.get("sku"),
        mls_id=best.get("identifier") if isinstance(best.get("identifier"), str) else None,
        address=clean_text(street),
        city=clean_text(city),
        state=clean_text(state),
        postal_code=clean_text(postal),
        lat=parse_num(best.get("latitude") or best.get("geo", {}).get("latitude") if isinstance(best.get("geo"), dict) else None),
        lon=parse_num(best.get("longitude") or best.get("geo", {}).get("longitude") if isinstance(best.get("geo"), dict) else None),
        price=parse_money(offers.get("price") or best.get("price")),
        beds=parse_num(best.get("numberOfBedrooms")),
        baths=parse_num(best.get("numberOfBathroomsTotal") or best.get("numberOfBathrooms")),
        sqft=parse_num(best.get("floorSize", {}).get("value") if isinstance(best.get("floorSize"), dict) else best.get("floorSize")),
        property_type=clean_text(best.get("@type")),
        status=clean_text(offers.get("availability") or best.get("availability")),
        description=clean_text(best.get("description")),
        image_urls=images,
        video_urls=videos,
        raw={"jsonld": best},
    )

