class Fetcher:
    def init(self, headers: Dict[str, str], timeout: int = 30):
        self.session = requests.Session()
        self.session.headers.update(headers)
        self.timeout = timeout

    def fetch(self, url: str, render_js: bool = False, wait_ms: int = 1500) -> Optional[str]:
        if render_js:
            return self.fetch_with_playwright(url, wait_ms=wait_ms)
        try:
            resp = self.session.get(url, timeout=self.timeout)
            if resp.status_code in (403, 429):
                print(f"[BLOCKED] {url} -> HTTP {resp.status_code}")
                return None
            resp.raise_for_status()
            text = resp.text
            lower = text.lower()
            if "captcha" in lower or "access denied" in lower:
                print(f"[BLOCKED] {url} -> captcha/access denied detected")
                return None
            return text
        except Exception as e:
            print(f"[ERROR] {url} -> {e}")
            return None

    def fetch_with_playwright(self, url: str, wait_ms: int = 1500) -> Optional[str]:
        if sync_playwright is None:
            print(f"[WARN] Playwright not installed, cannot render JS page: {url}")
            return None
        try:
            with sync_playwright() as p:
                browser = p.chromium.launch(headless=True)
                page = browser.new_page()
                page.goto(url, wait_until="networkidle", timeout=45000)
                page.wait_for_timeout(wait_ms)
                html = page.content()
                browser.close()
                return html
        except Exception as e:
            print(f"[ERROR] JS fetch failed {url} -> {e}")
            return None

