def safe_filename(url: str) -> str:
    h = hashlib.sha256(url.encode("utf-8")).hexdigest()[:16]
    path = urlparse(url).path
    ext = os.path.splitext(path)[1] or ".bin"
    return f"{h}{ext}"

def download_media(fetcher: Fetcher, canonical: Dict[str, Dict[str, Any]], out_dir: str):
    os.makedirs(out_dir, exist_ok=True)

    for key, payload in canonical.items():
        listing_dir = os.path.join(out_dir, key.replace(":", "_"))
        os.makedirs(listing_dir, exist_ok=True)

        for url in payload.get("image_urls", []):
            try:
                r = fetcher.session.get(url, timeout=30, stream=True)
                if r.status_code == 200:
                    with open(os.path.join(listing_dir, safe_filename(url)), "wb") as f:
                        for chunk in r.iter_content(8192):
                            f.write(chunk)
            except Exception:
                pass

For videos, often better to keep the URL unless explicitly permitted and needed.
        with open(os.path.join(listing_dir, "video_urls.json"), "w", encoding="utf-8") as f:
            json.dump(payload.get("video_urls", []), f, ensure_ascii=False, indent=2)

