class Storage:
    def init(self, db_path: str):
        self.conn = sqlite3.connect(db_path)
        self.init_db()

    def init_db(self):
        cur = self.conn.cursor()
        cur.execute("""
        CREATE TABLE IF NOT EXISTS source_listings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            dedupe_key TEXT,
            source_name TEXT,
            source_url TEXT UNIQUE,
            payload_json TEXT,
            scraped_at TEXT
        )
        """)
        cur.execute("""
        CREATE TABLE IF NOT EXISTS canonical_listings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            dedupe_key TEXT UNIQUE,
            payload_json TEXT,
            updated_at TEXT
        )
        """)
        self.conn.commit()

    def save_source(self, listing: Listing):
        cur = self.conn.cursor()
        cur.execute("""
        INSERT OR REPLACE INTO source_listings
        (dedupe_key, source_name, source_url, payload_json, scraped_at)
        VALUES (?, ?, ?, ?, ?)
        """, (
            dedupe_key(listing),
            listing.source_name,
            listing.source_url,
            json.dumps(asdict(listing), ensure_ascii=False),
            listing.scraped_at
        ))
        self.conn.commit()

    def save_canonical(self, key: str, payload: Dict[str, Any]):
        cur = self.conn.cursor()
        cur.execute("""
        INSERT OR REPLACE INTO canonical_listings
        (dedupe_key, payload_json, updated_at)
        VALUES (?, ?, ?)
        """, (
            key,
            json.dumps(payload, ensure_ascii=False),
            now_iso()
        ))
        self.conn.commit()

