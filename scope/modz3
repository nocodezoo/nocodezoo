@dataclass
class TimingRecord:
    """Single timing measurement."""
    category: str  # "layer", "step", "tile", "total"
    index: int
    start_time: float
    end_time: float
    metadata: Dict[str, Any] = field(default_factory=dict)

    @property
    def duration_ms(self) -> float:
        return (self.end_time - self.start_time) * 1000

    @property
    def duration_s(self) -> float:
        return self.end_time - self.start_time


class BenchmarkTimer:
    """
    Context manager and utility for wall-clock timing at multiple granularities.
    Tracks per-layer, per-timestep, and per-tile timings.
    """

    def __init__(self):
        self._records: List[TimingRecord] = []
        self._active_contexts: Dict[str, float] = {}
        self._counters: Dict[str, int] = {"layer": 0, "step": 0, "tile": 0}
        self._start_time: float = 0.0

    def start_global(self) -> None:
        """Start the global timer."""
        self._start_time = time.perf_counter()

    @property
    def global_elapsed(self) -> float:
        return time.perf_counter() - self._start_time

    @contextmanager
    def time_layer(self, layer_idx: int, **metadata):
        """Context manager for timing a single layer."""
        start = time.perf_counter()
        yield
        end = time.perf_counter()
        self._records.append(TimingRecord(
            category="layer", index=layer_idx,
            start_time=start, end_time=end, metadata=metadata
        ))
        self._counters["layer"] += 1

    @contextmanager
    def time_step(self, step_idx: int, **metadata):
        """Context manager for timing a denoising step."""
        start = time.perf_counter()
        yield
        end = time.perf_counter()
        self._records.append(TimingRecord(
            category="step", index=step_idx,
            start_time=start, end_time=end, metadata=metadata
        ))
        self._counters["step"] += 1

    @contextmanager
    def time_tile(self, tile_idx: int, **metadata):
        """Context manager for timing tile processing."""
        start = time.perf_counter()
        yield
        end = time.perf_counter()
        self._records.append(TimingRecord(
            category="tile", index=tile_idx,
            start_time=start, end_time=end, metadata=metadata
        ))
        self._counters["tile"] += 1

    @contextmanager
    def time_custom(self, category: str, index: int = 0, **metadata):
        """Context manager for arbitrary timing."""
        start = time.perf_counter()
        yield
        end = time.perf_counter()
        self._records.append(TimingRecord(
            category=category, index=index,
            start_time=start, end_time=end, metadata=metadata
        ))

    def get_records(self, category: Optional[str] = None) -> List[TimingRecord]:
        """Get timing records, optionally filtered by category."""
        if category is None:
            return self._records
        return [r for r in self._records if r.category == category]

    def get_stats(self, category: str) -> Dict[str, float]:
        """Get summary statistics for a category."""
        records = self.get_records(category)
        if not records:
            return {"count": 0, "mean_ms": 0, "min_ms": 0, "max_ms": 0, "std_ms": 0, "total_ms": 0}

        durations = [r.duration_ms for r in records]
        return {
            "count": len(durations),
            "mean_ms": float(np.mean(durations)),
            "min_ms": float(np.min(durations)),
            "max_ms": float(np.max(durations)),
            "std_ms": float(np.std(durations)),
            "total_ms": float(np.sum(durations)),
            "p50_ms": float(np.percentile(durations, 50)),
            "p95_ms": float(np.percentile(durations, 95)),
            "p99_ms": float(np.percentile(durations, 99)),
        }

    def summary(self) -> Dict[str, Dict[str, float]]:
        """Get full summary across all categories."""
        categories = set(r.category for r in self._records)
        return {cat: self.get_stats(cat) for cat in categories}


