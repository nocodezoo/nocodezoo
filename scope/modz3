        self._monitoring = False
        if self._thread:
            self._thread.join(timeout=2.0)
        return self._samples.copy()

    def _sample_loop(self):
        while self._monitoring:
            sample = self._read_gpu_stats()
            if sample:
                self._samples.append(sample)
            time.sleep(self.sample_interval_ms / 1000.0)

    def _read_gpu_stats(self) -> Optional[Dict]:
        try:
Use sysctl for basic GPU frequency info
            result = subprocess.run(
                ["sysctl", "-n", "hw.perflevel0.gpufreq"],
                capture_output=True, text=True, timeout=1.0
            )
            gpu_freq = int(result.stdout.strip()) if result.returncode == 0 else 0

Memory pressure from vm_stat
            vm_result = subprocess.run(
                ["vm_stat"], capture_output=True, text=True, timeout=1.0
            )
            pages_free = 0
            pages_active = 0
            for line in vm_result.stdout.split("\n"):
                if "Pages free" in line:
                    pages_free = int(line.split(":")[1].strip().rstrip("."))
                elif "Pages active" in line:
                    pages_active = int(line.split(":")[1].strip().rstrip("."))

            page_size = 16384  # Apple Silicon uses 16KB pages
            free_mb = (pages_free * page_size) / (1024 * 1024)
            active_mb = (pages_active * page_size) / (1024 * 1024)

            return {
                "timestamp": time.perf_counter(),
                "gpu_freq_mhz": gpu_freq,
                "memory_free_mb": free_mb,
                "memory_active_mb": active_mb,
                "memory_pressure_pct": (active_mb / (active_mb + free_mb)) * 100 if (active_mb + free_mb) > 0 else 0,
            }
        except Exception:
            return None

    def get_summary(self) -> Dict:
        if not self._samples:
            return {"error": "No samples collected"}
        pressures = [s["memory_pressure_pct"] for s in self._samples]
        freqs = [s["gpu_freq_mhz"] for s in self._samples if s["gpu_freq_mhz"] > 0]
        return {
            "sample_count": len(self._samples),
            "duration_s": (self._samples"timestamp" - self._samples"timestamp") if len(self._samples) > 1 else 0,
            "memory_pressure_mean_pct": np.mean(pressures),
            "memory_pressure_max_pct": max(pressures),
            "gpu_freq_mean_mhz": np.mean(freqs) if freqs else 0,
            "gpu_freq_min_mhz": min(freqs) if freqs else 0,
        }

