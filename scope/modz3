class ProfileExporter:
    """Export profiling data to various formats for analysis."""

    def init(self, output_dir: str = "./pma2_profiles"):
        self.output_dir = Path(output_dir)
        self.output_dir.mkdir(parents=True, exist_ok=True)

    def export_json(self, data: Dict, filename: str = "profile_report.json") -> str:
        path = self.output_dir / filename
        with open(path, "w") as f:
            json.dump(data, f, indent=2, default=str)
        return str(path)

    def export_csv_timings(self, records: List[TimingRecord], filename: str = "timings.csv") -> str:
        path = self.output_dir / filename
        with open(path, "w") as f:
            f.write("name,duration_ms,memory_before_mb,memory_after_mb,memory_delta_mb\n")
            for r in records:
                f.write(f"{r.name},{r.duration_ms:.3f},{r.memory_before_mb:.1f},"
                        f"{r.memory_after_mb:.1f},{r.memory_delta_mb:.1f}\n")
        return str(path)

    def export_chrome_trace(self, records: List[TimingRecord], filename: str = "trace.json") -> str:
        """Export in Chrome Trace Event format for chrome://tracing visualization."""
        events = []
        for r in records:
            events.append({
                "name": r.name,
                "cat": "inference",
                "ph": "X",  # Complete event
                "ts": r.start * 1_000_000,  # microseconds
                "dur": r.duration_ms * 1000,  # microseconds
                "pid": 1,
                "tid": 1,
                "args": {
                    "memory_delta_mb": r.memory_delta_mb,
                    **r.metadata,
                },
            })
        path = self.output_dir / filename
        with open(path, "w") as f:
            json.dump({"traceEvents": events}, f)
        return str(path)

    def generate_full_report(
        self,
        timing_profiler: WallClockProfiler,
        nvme_profiler: NVMeThroughputProfiler,
        thermal_monitor: ThermalMonitor,
        gpu_monitor: MetalGPUMonitor,
        quality_metrics: Optional[Dict] = None,
        bottleneck_report: Optional[str] = None,
    ) -> Dict:
        """Compile all profiling data into a comprehensive report."""
        report = {
            "meta": {
                "generated_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                "platform": "Apple Silicon (M-series)",
                "python_version": f"{os.sys.version}",
            },
            "timing": timing_profiler.summary(),
            "nvme": nvme_profiler.get_summary(),
            "thermal": thermal_monitor.get_summary(),
            "gpu": gpu_monitor.get_summary(),
        }
        if quality_metrics:
            report["quality"] = quality_metrics
        if bottleneck_report:
            report["bottleneck_analysis"] = bottleneck_report

Export all formats
        json_path = self.export_json(report)
        csv_path = self.export_csv_timings(timing_profiler.records)
        trace_path = self.export_chrome_trace(timing_profiler.records)

        report["export_paths"] = {
            "json": json_path,
            "csv": csv_path,
            "chrome_trace": trace_path,
        }
        return report

