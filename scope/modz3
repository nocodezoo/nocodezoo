@dataclass
class TimingRecord:
    name: str
    start: float = 0.0
    end: float = 0.0
    duration_ms: float = 0.0
    memory_before_mb: float = 0.0
    memory_after_mb: float = 0.0
    memory_delta_mb: float = 0.0
    metadata: Dict = field(default_factory=dict)


class WallClockProfiler:
    """High-resolution wall-clock profiler with memory snapshots."""

    def init(self):
        self.records: List[TimingRecord] = []
        self._active: Dict[str, TimingRecord] = {}
        self._lock = threading.Lock()

    def start(self, name: str, metadata: Dict = None):
        record = TimingRecord(
            name=name,
            start=time.perf_counter(),
            memory_before_mb=self._get_memory_mb(),
            metadata=metadata or {}
        )
        with self._lock:
            self._active[name] = record

    def stop(self, name: str) -> TimingRecord:
        end_time = time.perf_counter()
        with self._lock:
            record = self._active.pop(name, None)
        if record is None:
            raise KeyError(f"No active timer: {name}")
        record.end = end_time
        record.duration_ms = (end_time - record.start) * 1000.0
        record.memory_after_mb = self._get_memory_mb()
        record.memory_delta_mb = record.memory_after_mb - record.memory_before_mb
        self.records.append(record)
        return record

    def context(self, name: str, metadata: Dict = None):
        return _TimerContext(self, name, metadata)

    def summary(self) -> Dict:
        grouped = defaultdict(list)
        for r in self.records:
            grouped[r.name].append(r)
        summary = {}
        for name, recs in grouped.items():
            durations = [r.duration_ms for r in recs]
            summary[name] = {
                "count": len(recs),
                "total_ms": sum(durations),
                "mean_ms": np.mean(durations),
                "std_ms": np.std(durations),
                "min_ms": min(durations),
                "max_ms": max(durations),
                "p50_ms": np.percentile(durations, 50),
                "p95_ms": np.percentile(durations, 95),
                "p99_ms": np.percentile(durations, 99),
                "total_memory_delta_mb": sum(r.memory_delta_mb for r in recs),
            }
        return summary

    def reset(self):
        self.records.clear()
        self._active.clear()

    @staticmethod
    def _get_memory_mb() -> float:
        try:
            import resource
            ru = resource.getrusage(resource.RUSAGE_SELF)
            return ru.ru_maxrss / (1024 * 1024)  # macOS reports bytes
        except Exception:
            return 0.0


class _TimerContext:
    def init(self, profiler: WallClockProfiler, name: str, metadata: Dict):
        self.profiler = profiler
        self.name = name
        self.metadata = metadata

    def enter(self):
        self.profiler.start(self.name, self.metadata)
        return self

    def exit(self, *_):
        self.profiler.stop(self.name)

