        self.current_bytes += size_bytes
        self.peak_bytes = max(self.peak_bytes, self.current_bytes)
        return True

    def release(self, name: str, size_bytes: Optional[int] = None) -> None:
        """Release allocated memory."""
        if name in self.allocations:
            release_amount = size_bytes or self.allocations[name]
            self.current_bytes -= min(release_amount, self.allocations[name])
            self.allocations[name] -= min(release_amount, self.allocations[name])
            if self.allocations[name] <= 0:
                del self.allocations[name]

    @property
    def available_bytes(self) -> int:
        return self.cap_bytes - self.current_bytes

    @property
    def utilization(self) -> float:
        return self.current_bytes / self.cap_bytes

    @property
    def is_under_pressure(self) -> bool:
        """Memory pressure: less than 500MB remaining."""
        return self.available_bytes < 500 * 1024**2

    @property
    def is_critical(self) -> bool:
        """Critical: less than 200MB remaining."""
        return self.available_bytes < 200 * 1024**2

    def summary(self) -> Dict[str, Any]:
        return {
            "current_mb": self.current_bytes / (1024**2),
            "peak_mb": self.peak_bytes / (1024**2),
            "cap_mb": self.cap_bytes / (1024**2),
            "utilization_pct": self.utilization * 100,
            "available_mb": self.available_bytes / (1024**2),
            "allocations": {k: v / (1024**2) for k, v in self.allocations.items()},
        }


@dataclass
class ProgressReport:
    """Progress tracking with ETA estimation."""
    total_steps: int = 0
    total_layers: int = 0
    total_tiles: int = 0
    completed_steps: int = 0
    completed_layers: int = 0
    completed_tiles: int = 0
    step_times: List[float] = field(default_factory=list)
    layer_times: List[float] = field(default_factory=list)
    tile_times: List[float] = field(default_factory=list)
    start_time: float = 0.0

    def start(self) -> None:
        self.start_time = time.perf_counter()

    @property
    def elapsed(self) -> float:
        return time.perf_counter() - self.start_time

    @property
    def eta_seconds(self) -> float:
        if not self.step_times:
            return 0.0
        avg_step = sum(self.step_times[-5:]) / len(self.step_times[-5:])
        remaining_steps = self.total_steps - self.completed_steps
        return avg_step * remaining_steps

    @property
    def progress_pct(self) -> float:
        if self.total_steps == 0:
            return 0.0
        return (self.completed_steps / self.total_steps) * 100

    def record_step(self, duration: float) -> None:
        self.step_times.append(duration)
        self.completed_steps += 1

    def record_layer(self, duration: float) -> None:
        self.layer_times.append(duration)
        self.completed_layers += 1

    def record_tile(self, duration: float) -> None:
        self.tile_times.append(duration)
        self.completed_tiles += 1

    def format_status(self) -> str:
        eta = self.eta_seconds
        return (
            f"Step {self.completed_steps}/{self.total_steps} "
            f"({self.progress_pct:.1f}%) | "
            f"Elapsed: {self.elapsed:.1f}s | "
            f"ETA: {eta:.1f}s | "
            f"Avg step: {sum(self.step_times) / max(1, len(self.step_times)):.2f}s"
        )


class NVMeDoubleBuffer:
    """
    Async double-buffered weight loader using mmap and asyncio.
    Prefetches next layer while current layer is being computed.
    """

    def __init__(
        self,
        weight_dir: Path,
        num_layers: int,
        layer_size_bytes: int,
        precision_schedule: PrecisionSchedule,
    ):
        self.weight_dir = weight_dir
        self.num_layers = num_layers
        self.base_layer_size = layer_size_bytes
        self.precision_schedule = precision_schedule

        self._buffers: List[Optional[np.ndarray]] = [None, None]
        self._buffer_layer_idx: List[int] = [-1, -1]
        self._buffer_precision: List[Optional[PrecisionBand]] = [None, None]
        self._active_buffer: int = 0
        self._prefetch_task: Optional[asyncio.Task] = None

        # Stats
        self.total_bytes_loaded: int = 0
        self.total_load_time: float = 0.0
        self.load_count: int = 0

    def _get_weight_path(self, layer_idx: int, precision: PrecisionBand) -> Path:
        """Get path to weight file for given layer and precision."""
        suffix_map = {
            PrecisionBand.FP16: "fp16",
            PrecisionBand.INT8: "int8",
            PrecisionBand.INT4: "int4",
            PrecisionBand.MIXED: "mixed",
        }
        return self.weight_dir / f"layer_{layer_idx:04d}_{suffix_map[precision]}.bin"

    def _layer_size_for_precision(self, precision: PrecisionBand) -> int:
        """Get expected layer size in bytes for a given precision."""
        factor = self.precision_schedule.get_weight_size_factor(precision)
        return int(self.base_layer_size * factor)

    async def _load_layer_async(
        self,
        layer_idx: int,
        precision: PrecisionBand,
        buffer_slot: int,
    ) -> None:
        """Asynchronously load a layer's weights into a buffer slot."""
        start = time.perf_counter()
        expected_size = self._layer_size_for_precision(precision)
        weight_path = self._get_weight_path(layer_idx, precision)

        loop = asyncio.get_event_loop()

        def _do_load():
            if weight_path.exists():
                fd = open(weight_path, 'rb')
                mm = mmap.mmap(fd.fileno(), 0, access=mmap.ACCESS_READ)
                data = np.frombuffer(mm[:expected_size], dtype=np.uint8).copy()
                mm.close()
                fd.close()
                return data
            else:
                # Simulate for development: create zero buffer of correct size
                return np.zeros(expected_size, dtype=np.uint8)

        data = await loop.run_in_executor(None, _do_load)
        self._buffers[buffer_slot] = data
        self._buffer_layer_idx[buffer_slot] = layer_idx
        self._buffer_precision[buffer_slot] = precision

        elapsed = time.perf_counter() - start
        self.total_bytes_loaded += expected_size
        self.total_load_time += elapsed
        self.load_count += 1

    async def prefetch_layer(
        self,
        layer_idx: int,
        precision: PrecisionBand,
    ) -> None:
        """Start prefetching next layer into the inactive buffer."""
        if layer_idx >= self.num_layers:
            return
        inactive = 1 - self._active_buffer
        # Only prefetch if not already loaded
        if (self._buffer_layer_idx[inactive] == layer_idx and
                self._buffer_precision[inactive] == precision):
            return
        self._prefetch_task = asyncio.create_task(
            self._load_layer_async(layer_idx, precision, inactive)
        )

    async def get_current_layer(
        self,
        layer_idx: int,
        precision: PrecisionBand,
    ) -> np.ndarray:
        """
        Get weights for the current layer, waiting for prefetch if needed.
        """
        # Wait for any pending prefetch
        if self._prefetch_task is not None:
            await self._prefetch_task
            self._prefetch_task = None

        # Check if layer is in either buffer
        if (self._buffer_layer_idx[self._active_buffer] == layer_idx and
                self._buffer_precision[self._active_buffer] == precision):
            result = self._buffers[self._active_buffer]
        elif (self._buffer_layer_idx[1 - self._active_buffer] == layer_idx and
              self._buffer_precision[1 - self._active_buffer] == precision):
            self._active_buffer = 1 - self._active_buffer
            result = self._buffers[self._active_buffer]
        else:
            # Synchronous load (cache miss)
            await self._load_layer_async(layer_idx, precision, self._active_buffer)
            result = self._buffers[self._active_buffer]

        # Swap for next prefetch
        self._active_buffer = 1 - self._active_buffer
        return result

    @property
    def throughput_gbs(self) -> float:
        """Measured NVMe throughput in GB/s."""
        if self.total_load_time == 0:
            return 0.0
        return (self.total_bytes_loaded / (1024**3)) / self.total_load_time

    def reset_stats(self) -> None:
        self.total_bytes_loaded = 0
        self.total_load_time = 0.0
        self.load_count = 0

    def cleanup(self) -> None:
        """Release buffers."""
        self._buffers = [None, None]
        self._buffer_layer_idx = [-1, -1]
        self._buffer_precision = [None, None]


class SequentialCFGEngine:
    """
    Sequential Classifier-Free Guidance with delta compression.
    Runs unconditional pass first, then conditional, storing only residual deltas.
    """

    def __init__(self, config: GuidanceConfig):
        self.config = config
        self._uncond_cache: Optional[np.ndarray] = None
        self._delta_stats = {"total_elements": 0, "zeroed_elements": 0}

    def compute_guidance(
        self,
        uncond_output: np.ndarray,
        cond_output: np.ndarray,
        t: float,
    ) -> np.ndarray:
        """Apply CFG: output = uncond + scale * (cond - uncond)."""
        scale = self.config.get_scale(t)
        delta = cond_output - uncond_output

        if self.config.delta_compression:
            delta = self._compress_delta(delta)

        guided = uncond_output + scale * delta
        return guided

    def _compress_delta(self, delta: np.ndarray) -> np.ndarray:
        """Apply sparse compression to delta."""
        abs_max = np.abs(delta).max()
        if abs_max == 0:
            return delta
        threshold = self.config.delta_threshold * abs_max
        mask = np.abs(delta) < threshold
        compressed = delta.copy()
        compressed[mask] = 0.0

        self._delta_stats["total_elements"] += delta.size
        self._delta_stats["zeroed_elements"] += int(mask.sum())
        return compressed

    @property
    def compression_ratio(self) -> float:
        total = self._delta_stats["total_elements"]
        if total == 0:
            return 0.0
        return self._delta_stats["zeroed_elements"] / total

    def cache_unconditional(self, output: np.ndarray) -> None:
        self._uncond_cache = output.copy()

    def get_cached_unconditional(self) -> Optional[np.ndarray]:
        return self._uncond_cache

    def clear_cache(self) -> None:
        self._uncond_cache = None

    def reset_stats(self) -> None:
        self._delta_stats = {"total_elements": 0, "zeroed_elements": 0}


