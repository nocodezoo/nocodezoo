class StreamingPipelineOrchestrator:
    """
    Main inference orchestrator combining:
    - Layer-sequential streaming with NVMe double buffering
    - Spatiotemporal tiling with boundary blending
    - Dynamic precision cycling
    - Sequential CFG with delta compression
    - Memory budget enforcement
    """

    def __init__(self, config: PipelineConfig):
        self.config = config
        self.memory = MemoryBudget(cap_bytes=int(config.memory_cap_gb * 1024**3))
        self.progress = ProgressReport()
        self.cfg_engine = SequentialCFGEngine(config.guidance)
        self._nvme_buffer: Optional[NVMeDoubleBuffer] = None
        self._degradation_log: List[str] = []
        self._is_initialized: bool = False

        self._callbacks: Dict[str, List[Callable]] = {
            "on_step_start": [],
            "on_step_end": [],
            "on_layer_start": [],
            "on_layer_end": [],
            "on_tile_complete": [],
            "on_memory_pressure": [],
            "on_degradation": [],
        }

    def register_callback(self, event: str, callback: Callable) -> None:
        """Register a callback for pipeline events."""
        if event in self._callbacks:
            self._callbacks[event].append(callback)

    def _fire_callbacks(self, event: str, **kwargs) -> None:
        for cb in self._callbacks.get(event, []):
            try:
                cb(**kwargs)
            except Exception:
                pass

    async def initialize(self) -> None:
        """Initialize pipeline components and reserve memory."""
        self._nvme_buffer = NVMeDoubleBuffer(
            weight_dir=self.config.weight_dir,
            num_layers=self.config.num_layers,
            layer_size_bytes=self.config.layer_size_fp16_bytes,
            precision_schedule=self.config.precision,
        )

        # Reserve fixed memory allocations
        latent_bytes = self.config.latent_size_bytes
        allocations = [
            ("latent_noisy", latent_bytes),
            ("latent_output", latent_bytes),
            ("weight_buffer_0", LAYER_WEIGHT_BUDGET_MB * 1024**2),
            ("weight_buffer_1", LAYER_WEIGHT_BUDGET_MB * 1024**2),
            ("activations", 200 * 1024**2),
            ("cfg_uncond_cache", latent_bytes),
            ("tiling_output_buffer", latent_bytes),
            ("tiling_weight_accum", latent_bytes // 16),  # Single channel float32
            ("system_overhead", int(M5_SYSTEM_OVERHEAD_GB * 1024**3)),
        ]

        for name, size in allocations:
            if not self.memory.allocate(name, size):
                raise MemoryError(
                    f"Cannot allocate '{name}' ({size / 1024**2:.1f}MB). "
                    f"Available: {self.memory.available_bytes / 1024**2:.1f}MB"
                )

        self._is_initialized = True
        if self.config.verbose:
            mem = self.memory.summary()
            print(f"[PMA²] Initialized. Memory: {mem['current_mb']:.0f}MB / {mem['cap_mb']:.0f}MB "
                  f"({mem['utilization_pct']:.1f}% used)")

    def _get_timestep_schedule(self) -> List[float]:
        """Generate normalized timestep schedule [1.0 -> 0.0]."""
        n = self.config.num_timesteps
        if self.config.scheduler == "flow_matching":
            return [1.0 - i / n for i in range(n)]
        else:
            steps = np.linspace(0, 1, n + 1)
            alphas = np.cos((steps + 0.008) / 1.008 * math.pi / 2) ** 2
            betas = 1 - alphas[1:] / alphas[:-1]
            return list(np.sqrt(1 - np.cumprod(1 - betas))[::-1])

    def _compute_tile_grid(self) -> List[Dict[str, int]]:
        """Compute tile coordinates for the latent volume."""
        cfg = self.config
        eff_h = cfg.tile_height - cfg.overlap_height
        eff_w = cfg.tile_width - cfg.overlap_width
        eff_t = cfg.tile_temporal - cfg.overlap_temporal

        n_t = max(1, math.ceil((cfg.latent_frames - cfg.overlap_temporal) / eff_t))
        n_h = max(1, math.ceil((cfg.latent_height - cfg.overlap_height) / eff_h))
        n_w = max(1, math.ceil((cfg.latent_width - cfg.overlap_width) / eff_w))

        tiles = []
        for it in range(n_t):
            t_start = it * eff_t
            t_end = min(t_start + cfg.tile_temporal, cfg.latent_frames)
            if t_end == cfg.latent_frames:
                t_start = max(0, t_end - cfg.tile_temporal)

            for ih in range(n_h):
                h_start = ih * eff_h
                h_end = min(h_start + cfg.tile_height, cfg.latent_height)
                if h_end == cfg.latent_height:
                    h_start = max(0, h_end - cfg.tile_height)

                for iw in range(n_w):
                    w_start = iw * eff_w
                    w_end = min(w_start + cfg.tile_width, cfg.latent_width)
                    if w_end == cfg.latent_width:
                        w_start = max(0, w_end - cfg.tile_width)

                    tiles.append({
                        "t_start": t_start, "t_end": t_end,
                        "h_start": h_start, "h_end": h_end,
                        "w_start": w_start, "w_end": w_end,
                        "idx_t": it, "idx_h": ih, "idx_w": iw,
                    })
        return tiles

    def _build_blend_mask(
        self, tile: Dict[str, int], n_t: int, n_h: int, n_w: int
    ) -> np.ndarray:
        """Build raised-cosine blend mask for a tile."""
        T = tile["t_end"] - tile["t_start"]
        H = tile["h_end"] - tile["h_start"]
        W = tile["w_end"] - tile["w_start"]
        ot = self.config.overlap_temporal
        oh = self.config.overlap_height
        ow = self.config.overlap_width

        mask = np.ones((T, H, W), dtype=np.float32)

        def cosine_ramp(length):
            t = np.linspace(0, math.pi, length, dtype=np.float32)
            return (1.0 - np.cos(t)) / 2.0

        # Temporal blending
        if tile["idx_t"] > 0 and ot > 0:
            ramp = cosine_ramp(ot)
            mask[:ot, :, :] *= ramp[:, None, None]
        if tile["idx_t"] < n_t - 1 and ot > 0:
            ramp = cosine_ramp(ot)
            mask[-ot:, :, :] *= ramp[::-1, None, None]

        # Height blending
        if tile["idx_h"] > 0 and oh > 0:
            ramp = cosine_ramp(oh)
            mask[:, :oh, :] *= ramp[None, :, None]
        if tile["idx_h"] < n_h - 1 and oh > 0:
            ramp = cosine_ramp(oh)
            mask[:, -oh:, :] *= ramp[None, ::-1, None]

        # Width blending
        if tile["idx_w"] > 0 and ow > 0:
            ramp = cosine_ramp(ow)
            mask[:, :, :ow] *= ramp[None, None, :]
        if tile["idx_w"] < n_w - 1 and ow > 0:
            ramp = cosine_ramp(ow)
            mask[:, :, -ow:] *= ramp[None, None, ::-1]

        return mask

    async def _run_single_pass_through_layers(
        self,
        x: np.ndarray,
        t: float,
        precision: PrecisionBand,
        condition: Optional[np.ndarray],
    ) -> np.ndarray:
        """
        Run input through all transformer layers sequentially with streaming.
        Each layer is loaded from NVMe just-in-time with double buffering.
        """
        current = x.copy()

        for layer_idx in range(self.config.num_layers):
            layer_start = time.perf_counter()

            self._fire_callbacks("on_layer_start", layer_idx=layer_idx, timestep=t)

            # Memory pressure check
            if self.memory.is_critical:
                self._handle_memory_pressure(layer_idx, t)

            # Get current layer weights (may wait for prefetch)
            weights = await self._nvme_buffer.get_current_layer(layer_idx, precision)

            # Immediately prefetch next layer
            if layer_idx < self.config.num_layers - 1:
                await self._nvme_buffer.prefetch_layer(layer_idx + 1, precision)

            # Execute layer forward pass
            # In production, this would be: dequantize -> attention -> FFN -> residual
            # Using MLX for GPU compute if available
            current = self._execute_layer(current, weights, layer_idx, t, condition)

            layer_duration = time.perf_counter() - layer_start
            self.progress.record_layer(layer_duration)
            self._fire_callbacks("on_layer_end", layer_idx=layer_idx, duration=layer_duration)

        return current

    def _execute_layer(
        self,
        x: np.ndarray,
        weights: np.ndarray,
        layer_idx: int,
        t: float,
        condition: Optional[np.ndarray],
    ) -> np.ndarray:
        """
        Execute a single DiT transformer layer.
        In production: AdaLN -> Self-Attention -> Cross-Attention -> FFN -> Residual.
        This is the compute placeholder that would use MLX kernels.
        """
        if HAS_MLX:
            x_mlx = mx.array(x)
            # Placeholder: In real implementation, weights would be dequantized
            # and used for actual matrix multiplications.
            # Simulating residual update with noise proportional to layer index
            scale = 0.001 / (1 + layer_idx * 0.01)
            residual = mx.random.normal(x_mlx.shape) * scale
            x_mlx = x_mlx + residual
            mx.eval(x_mlx)
            return np.array(x_mlx)
        else:
            # CPU fallback simulation
            scale = 0.001 / (1 + layer_idx * 0.01)
            return x + np.random.randn(*x.shape).astype(np.float32) * scale

    def _handle_memory_pressure(self, layer_idx: int, t: float) -> None:
        """
        Handle memory pressure through graceful degradation.
        Strategies: drop to lower precision, reduce tile overlap, skip coherence.
        """
        msg = f"Memory pressure at layer {layer_idx}, t={t:.3f}. Degrading gracefully."
        self._degradation_log.append(msg)
        self._fire_callbacks("on_memory_pressure", message=msg)

        if self.config.verbose:
            print(f"[PMA² WARNING] {msg}")

        # Strategy 1: Force garbage collection of caches
        self.cfg_engine.clear_cache()

        # Strategy 2: If still critical, signal to reduce precision for remaining layers
        if self.memory.is_critical:
            degradation_msg = "Forcing INT4 precision for remaining layers due to memory pressure."
            self._degradation_log.append(degradation_msg)
            self._fire_callbacks("on_degradation", message=degradation_msg)

    async def _process_tile_full_stack(
        self,
        tile_latent: np.ndarray,
        t: float,
        precision: PrecisionBand,
        condition: Optional[np.ndarray],
        is_unconditional: bool,
    ) -> np.ndarray:
        """Process a single tile through the entire layer stack."""
        return await self._run_single_pass_through_layers(
            tile_latent, t, precision, condition if not is_unconditional else None
        )

    async def run_inference(
        self,
        initial_noise: Optional[np.ndarray] = None,
        condition: Optional[np.ndarray] = None,
        negative_condition: Optional[np.ndarray] = None,
    ) -> InferenceResult:
        """
        Main inference entry point. Runs the full denoising loop with:
        - Spatiotemporal tiling
        - Layer-sequential streaming
        - Sequential CFG
        - Dynamic precision cycling
        - Memory budget enforcement

        Args:
            initial_noise: Starting noise tensor (C, T, H, W). Generated if None.
            condition: Conditioning tensor for CFG (text embeddings, etc.)
            negative_condition: Negative/null condition for unconditional pass.

        Returns:
            InferenceResult with output latent and performance metrics.
        """
        if not self._is_initialized:
            await self.initialize()

        # Setup
        cfg = self.config
        shape = cfg.latent_shape

        if initial_noise is None:
            initial_noise = np.random.randn(*shape).astype(np.float32)

        x = initial_noise.copy()
        timesteps = self._get_timestep_schedule()
        tile_grid = self._compute_tile_grid()

        # Compute grid dimensions for blend masks
        eff_t = cfg.tile_temporal - cfg.overlap_temporal
        eff_h = cfg.tile_height - cfg.overlap_height
        eff_w = cfg.tile_width - cfg.overlap_width
        n_t = max(1, math.ceil((cfg.latent_frames - cfg.overlap_temporal) / eff_t))
        n_h = max(1, math.ceil((cfg.latent_height - cfg.overlap_height) / eff_h))
        n_w = max(1, math.ceil((cfg.latent_width - cfg.overlap_width) / eff_w))

        # Progress setup
        self.progress = ProgressReport(
            total_steps=len(timesteps),
            total_layers=cfg.num_layers * len(timesteps) * len(tile_grid) * 2,  # x2 for CFG
            total_tiles=len(tile_grid) * len(timesteps),
        )
        self.progress.start()

        if cfg.verbose:
            print(f"[PMA²] Starting inference: {len(timesteps)} steps, "
                  f"{len(tile_grid)} tiles/step, {cfg.num_layers} layers/tile")
            print(f"[PMA²] Model: {cfg.total_model_size_gb:.1f}GB total, "
                  f"streaming {LAYER_WEIGHT_BUDGET_MB}MB/layer")

        try:
            # ==========================================
            # Main Denoising Loop
            # ==========================================
            for step_idx, t in enumerate(timesteps):
                step_start = time.perf_counter()

                self._fire_callbacks("on_step_start", step=step_idx, timestep=t)

                # Determine precision for this timestep
                precision = cfg.precision.get_precision(t)

                if cfg.verbose and step_idx % 10 == 0:
                    print(f"[PMA²] {self.progress.format_status()} | "
                          f"Precision: {precision.value}")

                # Output accumulation buffers for this step
                output_accum = np.zeros_like(x)
                weight_accum = np.zeros((1, *shape[1:]), dtype=np.float32)

                # ==========================================
                # Process each tile
                # ==========================================
                for tile_idx, tile in enumerate(tile_grid):
                    tile_start = time.perf_counter()

                    # Extract tile from current noisy latent
                    tile_latent = x[
                        :,
                        tile["t_start"]:tile["t_end"],
                        tile["h_start"]:tile["h_end"],
                        tile["w_start"]:tile["w_end"],
                    ].copy()

                    # --- Sequential CFG ---
                    # Pass 1: Unconditional (null condition)
                    uncond_output = await self._process_tile_full_stack(
                        tile_latent, t, precision, negative_condition,
                        is_unconditional=True,
                    )

                    # Cache unconditional result
                    self.cfg_engine.cache_unconditional(uncond_output)

                    # Pass 2: Conditional
                    cond_output = await self._process_tile_full_stack(
                        tile_latent, t, precision, condition,
                        is_unconditional=False,
                    )

                    # Apply guidance with delta compression
                    guided_output = self.cfg_engine.compute_guidance(
                        uncond_output, cond_output, t
                    )

                    # Clear unconditional cache to free memory
                    self.cfg_engine.clear_cache()

                    # --- Apply scheduler step ---
                    # For flow matching: x_{t-dt} = x_t + dt * v_predicted
                    dt = 1.0 / cfg.num_timesteps
                    tile_result = tile_latent + dt * guided_output

                    # --- Scatter back with blending ---
                    blend_mask = self._build_blend_mask(tile, n_t, n_h, n_w)
                    mask_expanded = blend_mask[np.newaxis, :, :, :]

                    output_accum[
                        :,
                        tile["t_start"]:tile["t_end"],
                        tile["h_start"]:tile["h_end"],
                        tile["w_start"]:tile["w_end"],
                    ] += tile_result * mask_expanded

                    weight_accum[
                        :,
                        tile["t_start"]:tile["t_end"],
                        tile["h_start"]:tile["h_end"],
                        tile["w_start"]:tile["w_end"],
                    ] += mask_expanded

                    tile_duration = time.perf_counter() - tile_start
                    self.progress.record_tile(tile_duration)
                    self._fire_callbacks("on_tile_complete", tile_idx=tile_idx, duration=tile_duration)

                # Normalize accumulated output by weights
                weight_accum = np.maximum(weight_accum, 1e-8)
                x = output_accum / weight_accum

                step_duration = time.perf_counter() - step_start
                self.progress.record_step(step_duration)

                self._fire_callbacks("on_step_end", step=step_idx, duration=step_duration)

            # ==========================================
            # Finalize
            # ==========================================
            total_time = self.progress.elapsed

            if cfg.verbose:
                print(f"\n[PMA²] Inference complete!")
                print(f"[PMA²] Total time: {total_time:.2f}s")
                print(f"[PMA²] Peak memory: {self.memory.peak_bytes / 1024**2:.0f}MB")
                print(f"[PMA²] NVMe throughput: {self._nvme_buffer.throughput_gbs:.2f} GB/s")
                print(f"[PMA²] CFG compression: {self.cfg_engine.compression_ratio * 100:.1f}%")
                if self._degradation_log:
                    print(f"[PMA²] Degradation events: {len(self._degradation_log)}")

            return InferenceResult(
                output_latent=x,
                total_time_seconds=total_time,
                peak_memory_mb=self.memory.peak_bytes / (1024**2),
                avg_step_time=sum(self.progress.step_times) / max(1, len(self.progress.step_times)),
                nvme_throughput_gbs=self._nvme_buffer.throughput_gbs,
                cfg_compression_ratio=self.cfg_engine.compression_ratio,
                steps_completed=self.progress.completed_steps,
                layers_per_step=cfg.num_layers * len(tile_grid) * 2,
                tiles_per_step=len(tile_grid),
                degradation_events=self._degradation_log.copy(),
                success=True,
            )

        except MemoryError as e:
            error_msg = f"Out of memory: {e}"
            if cfg.verbose:
                print(f"[PMA² ERROR] {error_msg}")
            return InferenceResult(
                output_latent=x,
                total_time_seconds=self.progress.elapsed,
                peak_memory_mb=self.memory.peak_bytes / (1024**2),
                avg_step_time=sum(self.progress.step_times) / max(1, len(self.progress.step_times)),
                nvme_throughput_gbs=self._nvme_buffer.throughput_gbs if self._nvme_buffer else 0,
                cfg_compression_ratio=self.cfg_engine.compression_ratio,
                steps_completed=self.progress.completed_steps,
                layers_per_step=cfg.num_layers,
                tiles_per_step=len(tile_grid),
                degradation_events=self._degradation_log,
                success=False,
                error_message=error_msg,
            )

        except Exception as e:
            error_msg = f"Pipeline error: {e}\n{traceback.format_exc()}"
            if cfg.verbose:
                print(f"[PMA² ERROR] {error_msg}")
            return InferenceResult(
                output_latent=x,
                total_time_seconds=self.progress.elapsed,
                peak_memory_mb=self.memory.peak_bytes / (1024**2),
                avg_step_time=0,
                nvme_throughput_gbs=0,
                cfg_compression_ratio=0,
                steps_completed=self.progress.completed_steps,
                layers_per_step=cfg.num_layers,
                tiles_per_step=len(tile_grid) if tile_grid else 0,
                degradation_events=self._degradation_log,
                success=False,
                error_message=error_msg,
            )

        finally:
            # Cleanup
            if self._nvme_buffer:
                self._nvme_buffer.cleanup()

    async def run_inference_with_benchmark(
        self,
        benchmark_suite: Any = None,
        **kwargs,
    ) -> Tuple[InferenceResult, Optional[Any]]:
        """Run inference with optional benchmarking integration."""
        if benchmark_suite is not None:
            benchmark_suite.start()
            self.register_callback("on_step_end", lambda **kw: benchmark_suite.record_step(kw))
            self.register_callback("on_layer_end", lambda **kw: benchmark_suite.record_layer(kw))

        result = await self.run_inference(**kwargs)

        if benchmark_suite is not None:
            benchmark_suite.stop()
            return result, benchmark_suite.get_report()

        return result, None

    def run(
        self,
        initial_noise: Optional[np.ndarray] = None,
        condition: Optional[np.ndarray] = None,
        negative_condition: Optional[np.ndarray] = None,
    ) -> InferenceResult:
        """
        Synchronous wrapper for run_inference().
        Creates a new event loop and runs the async pipeline.
        """
        return asyncio.run(
            self.run_inference(
                initial_noise=initial_noise,
                condition=condition,
                negative_condition=negative_condition,
            )
        )

    def estimate_total_time(self) -> Dict[str, float]:
        """
        Estimate total inference time based on hardware specs.
        Useful for setting expectations before running.
        """
        cfg = self.config
        tile_grid = self._compute_tile_grid()
        num_tiles = len(tile_grid)

        # Time per layer load from NVMe
        avg_precision = PrecisionBand.INT4  # Most layers use INT4
        avg_layer_bytes = cfg.layer_size_fp16_bytes * cfg.precision.get_weight_size_factor(avg_precision)
        layer_load_time = avg_layer_bytes / (M5_NVME_READ_GBS * 1024**3)

        # Time per layer compute (rough: memory bandwidth bound)
        layer_compute_time = avg_layer_bytes / (M5_MEMORY_BW_GBS * 1024**3)

        # Total layers per step: num_layers * num_tiles * 2 (CFG)
        layers_per_step = cfg.num_layers * num_tiles * 2

        # Per step time (IO and compute overlap via double buffering)
        step_io_time = layer_load_time * layers_per_step
        step_compute_time = layer_compute_time * layers_per_step
        # With double buffering, effective time is max(io, compute) not sum
        step_time = max(step_io_time, step_compute_time) * 1.2  # 20% overhead

        total_time = step_time * cfg.num_timesteps

        return {
            "estimated_total_seconds": total_time,
            "estimated_step_seconds": step_time,
            "layers_per_step": layers_per_step,
            "num_tiles": num_tiles,
            "avg_layer_load_ms": layer_load_time * 1000,
            "avg_layer_compute_ms": layer_compute_time * 1000,
            "bottleneck": "io" if step_io_time > step_compute_time else "compute",
        }


