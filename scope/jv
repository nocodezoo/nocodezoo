## Decision Logic

The complete lookup-and-execute decision flow is defined below as a formal agent policy.

```
PROCEDURE execute_with_diary(intended_action):

  // PHASE 1: LOOKUP
  matching_entry = diary.find(command_or_action ~= intended_action)

  IF matching_entry EXISTS:
    IF is_entry_valid(matching_entry, current_step):

      IF matching_entry.outcome_status == SUCCESS:
        LOG "[DIARY HIT] TDE-{id}: Skipping '{action}' — already succeeded at T+{time}."
        LOG "Cached summary: {matching_entry.summary}"
        write_diary_entry(
          category = matching_entry.category,
          command_or_action = intended_action,
          outcome_status = SKIPPED,
          summary = "Skipped — valid cache hit from " + matching_entry.entry_id,
          follow_up_required = NO
        )
        RETURN matching_entry.summary

      IF matching_entry.outcome_status == FAIL:
        LOG "[DIARY BLOCK] TDE-{id}: Will NOT re-execute '{action}' — recorded failure exists."
        LOG "Known failure: {matching_entry.summary}"
        LOG "Proposing alternative strategy before retrying."
        RETURN propose_alternative(matching_entry)

      IF matching_entry.outcome_status == PARTIAL:
        LOG "[DIARY PARTIAL] TDE-{id}: Prior attempt was partial. Executing remaining portion only."
        // Continue to execution with scoped action

    ELSE:
      LOG "[DIARY STALE] TDE-{id}: Entry exists but is stale. Re-executing."
      mark_entry_superseded(matching_entry)
      // Continue to execution

  ELSE:
    LOG "[DIARY MISS] No diary entry found for '{action}'. Executing fresh."

  // PHASE 2: EXECUTE
  result = execute(intended_action)

  // PHASE 3: WRITE
  write_diary_entry(
    category = classify(intended_action),
    command_or_action = intended_action,
    outcome_status = evaluate(result),
    summary = summarize(result),
    raw_output_snippet = result.output[:5_lines],
    dependencies_noted = extract_dependencies(result),
    version_info = extract_versions(result),
    follow_up_required = assess_follow_up(result),
    staleness_ttl = lookup_ttl(category),
    valid_until_step = current_step + staleness_ttl
  )

  RETURN result
```

