class ContextManager:
    """
    Sliding window context manager with token budget enforcement.
    Maintains conversation history within CONTEXT_WINDOW token limit.
    """

    def __init__(self, max_tokens: int = CONTEXT_WINDOW) -> None:
        self.max_tokens = max_tokens
        self._messages: list[ContextMessage] = []
        self._total_tokens: int = 0

    @property
    def total_tokens(self) -> int:
        return self._total_tokens

    @property
    def utilization(self) -> float:
        return self._total_tokens / self.max_tokens

    def add_message(self, role: str, content: str) -> None:
        """Add a message, evicting oldest non-system messages if over budget."""
        msg = ContextMessage(role=role, content=content)
        self._messages.append(msg)
        self._total_tokens += msg.token_estimate
        self._evict_if_needed()

    def _evict_if_needed(self) -> None:
        """
        Evict oldest non-system messages when over token budget.
        Always preserves the system message (index 0).
        """
        while self._total_tokens > self.max_tokens and len(self._messages) > 2:
            # Find first non-system message to evict
            for i, msg in enumerate(self._messages):
                if msg.role != "system":
                    evicted = self._messages.pop(i)
                    self._total_tokens -= evicted.token_estimate
                    logger.debug(
                        "Evicted context message (role=%s, tokens=%d)",
                        evicted.role,
                        evicted.token_estimate,
                    )
                    break

    def get_messages(self) -> list[dict[str, str]]:
        """Return messages formatted for MiniMax API consumption."""
        return [{"role": m.role, "content": m.content} for m in self._messages]

    def clear(self, keep_system: bool = True) -> None:
        """Clear context, optionally preserving the system message."""
        if keep_system and self._messages and self._messages[0].role == "system":
            system_msg = self._messages[0]
            self._messages = [system_msg]
            self._total_tokens = system_msg.token_estimate
        else:
            self._messages = []
            self._total_tokens = 0


