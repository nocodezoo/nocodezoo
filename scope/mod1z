class MLXTilingEngine(SpatiotemporalTilingEngine):
    """MLX-accelerated tiling engine for Apple Silicon GPU."""

    def __init__(self, config: TilingConfig):
        if not HAS_MLX:
            raise RuntimeError("MLX not available. Install with: pip install mlx")
        super().__init__(config)

    def tile_iterator_mlx(
        self,
        latent: "mx.array",
    ) -> Iterator[Tuple[TileCoordinate, "mx.array", "mx.array"]]:
        """
        MLX-native tile iterator yielding mx.array tiles.

        Args:
            latent: MLX array of shape (C, T, H, W)

        Yields:
            (coordinate, tile_data_mlx, blend_mask_mlx)
        """
        grid = self.compute_tile_grid()

        for coord in grid:
            tile_data = latent[
                :,
                coord.t_start:coord.t_end,
                coord.h_start:coord.h_end,
                coord.w_start:coord.w_end,
            ]
            # Force evaluation to limit memory
            mx.eval(tile_data)

            blend_mask_np = self.get_blend_mask(coord)
            blend_mask_mlx = mx.array(blend_mask_np)

            yield coord, tile_data, blend_mask_mlx

    def scatter_tile_mlx(
        self,
        output: "mx.array",
        weights: "mx.array",
        coord: TileCoordinate,
        tile_result: "mx.array",
        blend_mask: "mx.array",
    ) -> Tuple["mx.array", "mx.array"]:
        """Scatter tile into output using MLX operations (returns new arrays)."""
        mask_expanded = mx.expand_dims(blend_mask, axis=0)

        # MLX doesn't support in-place slice assignment; use index_put equivalent
        # For now, accumulate via numpy conversion (MLX scatter is limited)
        output_np = np.array(output)
        weights_np = np.array(weights)
        tile_np = np.array(tile_result)
        mask_np = np.array(mask_expanded)

        output_np[
            :, coord.t_start:coord.t_end,
            coord.h_start:coord.h_end,
            coord.w_start:coord.w_end,
        ] += tile_np * mask_np

        weights_np[
            :, coord.t_start:coord.t_end,
            coord.h_start:coord.h_end,
            coord.w_start:coord.w_end,
        ] += mask_np

        return mx.array(output_np), mx.array(weights_np)


