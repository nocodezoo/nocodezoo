def create_720p_tiling_config(
    num_frames: int = 40,
    tile_size: int = 48,
    overlap: int = 8,
    temporal_tile: int = 12,
    temporal_overlap: int = 4,
) -> TilingConfig:
    """
    Create a tiling config optimized for 720p video latents.
    720p in latent space (8x downsampled): 90h x 160w
    """
    return TilingConfig(
        full_height=90,
        full_width=160,
        full_temporal=num_frames,
        tile_height=tile_size,
        tile_width=tile_size,
        tile_temporal=temporal_tile,
        overlap_height=overlap,
        overlap_width=overlap,
        overlap_temporal=temporal_overlap,
    )


