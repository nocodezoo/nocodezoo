<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>AGENT DIRECTIVE — ComfyUI 3D Parallax SLM</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@300;400;500&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg-primary: #0f1117;
    --bg-secondary: #13161f;
    --bg-card: #161b27;
    --bg-code: #0d1117;
    --blue: #3b82f6;
    --cyan: #06b6d4;
    --purple: #8b5cf6;
    --green: #10b981;
    --amber: #f59e0b;
    --red: #ef4444;
    --text-primary: #e2e8f0;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --border: #1e2d45;
    --glow-blue: rgba(59, 130, 246, 0.15);
    --glow-purple: rgba(139, 92, 246, 0.15);
    --glow-cyan: rgba(6, 182, 212, 0.15);
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    min-height: 100vh;
    padding: 40px 20px 80px;
  }

  /* ── PAGE WRAPPER ── */
  .page-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── TOP BAR ── */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 8px 16px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.04em;
  }

  .top-bar-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--green);
    display: inline-block;
    margin-right: 6px;
    box-shadow: 0 0 6px var(--green);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ── HEADER ── */
  .directive-header {
    text-align: center;
    padding: 48px 32px 40px;
    background: linear-gradient(160deg, #0d1321 0%, #111827 40%, #0f1117 100%);
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 32px;
    position: relative;
    overflow: hidden;
  }

  .directive-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 0%, rgba(59,130,246,0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 100%, rgba(139,92,246,0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .classified-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(239,68,68,0.15), rgba(239,68,68,0.05));
    border: 1.5px solid rgba(239,68,68,0.5);
    color: #f87171;
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    padding: 6px 18px;
    border-radius: 4px;
    margin-bottom: 24px;
    text-transform: uppercase;
    position: relative;
  }

  .classified-badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-dot 1.5s infinite;
  }

  .classified-badge::after {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse-dot 1.5s infinite 0.75s;
  }

  .directive-title {
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #e2e8f0 0%, #93c5fd 40%, #a78bfa 70%, #67e8f9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
  }

  .directive-subtitle {
    color: var(--text-secondary);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    margin-bottom: 28px;
    position: relative;
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    position: relative;
  }

  .meta-chip {
    background: rgba(30, 45, 69, 0.7);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-family: 'Fira Code', monospace;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-chip .chip-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
  }

  /* ── TOC ── */
  .toc-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 28px;
  }

  .toc-title {
    font-size: 0.75rem;
    font-family: 'Fira Code', monospace;
    color: var(--cyan);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .toc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
  }

  .toc-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 13px;
    transition: all 0.2s ease;
  }

  .toc-item:hover {
    background: rgba(59,130,246,0.07);
    border-color: rgba(59,130,246,0.2);
    color: var(--text-primary);
  }

  .toc-num {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--blue);
    min-width: 22px;
  }

  /* ── SECTION CARDS ── */
  .section-card {
    background: var(--bg-card);
    border-radius: 14px;
    margin-bottom: 24px;
    border: 1px solid var(--border);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .section-card:hover {
    border-color: rgba(59,130,246,0.3);
    box-shadow: 0 0 30px rgba(59,130,246,0.06);
  }

  .section-card.accent-cyan:hover { border-color: rgba(6,182,212,0.3); box-shadow: 0 0 30px rgba(6,182,212,0.06); }
  .section-card.accent-purple:hover { border-color: rgba(139,92,246,0.3); box-shadow: 0 0 30px rgba(139,92,246,0.06); }
  .section-card.accent-green:hover { border-color: rgba(16,185,129,0.3); box-shadow: 0 0 30px rgba(16,185,129,0.06); }
  .section-card.accent-amber:hover { border-color: rgba(245,158,11,0.3); box-shadow: 0 0 30px rgba(245,158,11,0.06); }

  .section-card details { display: block; }

  .section-card details[open] > summary .chevron {
    transform: rotate(180deg);
  }

  .section-summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .section-summary::-webkit-details-marker { display: none; }

  details[open] .section-summary {
    border-bottom-color: var(--border);
    background: rgba(255,255,255,0.02);
  }

  .section-summary:hover { background: rgba(255,255,255,0.02); }

  .section-badge {
    width: 36px; height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    background: rgba(59,130,246,0.1);
    border: 1px solid rgba(59,130,246,0.25);
  }

  .accent-cyan .section-badge { background: rgba(6,182,212,0.1); border-color: rgba(6,182,212,0.25); }
  .accent-purple .section-badge { background: rgba(139,92,246,0.1); border-color: rgba(139,92,246,0.25); }
  .accent-green .section-badge { background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.25); }
  .accent-amber .section-badge { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.25); }

  .section-title-group { flex: 1; min-width: 0; }

  .section-phase-label {
    font-size: 10px;
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 2px;
  }

  .accent-cyan .section-phase-label { color: var(--cyan); }
  .accent-purple .section-phase-label { color: var(--purple); }
  .accent-green .section-phase-label { color: var(--green); }
  .accent-amber .section-phase-label { color: var(--amber); }

  .section-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chevron {
    color: var(--text-muted);
    font-size: 12px;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .section-body {
    padding: 24px 28px;
  }

  /* ── CONTENT ELEMENTS ── */
  .section-body p {
    color: var(--text-secondary);
    margin-bottom: 14px;
    line-height: 1.75;
  }

  .section-body p:last-child { margin-bottom: 0; }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0;
  }

  .info-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
  }

  .info-label {
    font-size: 10px;
    font-family: 'Fira Code', monospace;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .info-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .info-value.blue { color: var(--blue); }
  .info-value.cyan { color: var(--cyan); }
  .info-value.green { color: var(--green); }
  .info-value.purple { color: var(--purple); }
  .info-value.amber { color: var(--amber); }

  /* ── LIST STYLES ── */
  .directive-list {
    list-style: none;
    margin: 12px 0;
  }

  .directive-list li {
    padding: 7px 0 7px 24px;
    position: relative;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(30,45,69,0.5);
    font-size: 14px;
  }

  .directive-list li:last-child { border-bottom: none; }

  .directive-list li::before {
    content: '▸';
    position: absolute;
    left: 4px;
    color: var(--blue);
    font-size: 12px;
    top: 8px;
  }

  .accent-cyan .directive-list li::before { color: var(--cyan); }
  .accent-purple .directive-list li::before { color: var(--purple); }
  .accent-green .directive-list li::before { color: var(--green); }
  .accent-amber .directive-list li::before { color: var(--amber); }

  .directive-list li strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  /* ── CODE BLOCKS ── */
  .code-block-wrapper {
    position: relative;
    margin: 16px 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(30,45,69,0.8);
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0a0d14;
    padding: 8px 14px;
    border-bottom: 1px solid rgba(30,45,69,0.8);
  }

  .code-lang {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .copy-btn {
    background: rgba(59,130,246,0.1);
    border: 1px solid rgba(59,130,246,0.2);
    color: var(--blue);
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .copy-btn:hover {
    background: rgba(59,130,246,0.2);
    border-color: rgba(59,130,246,0.4);
  }

  .copy-btn.copied {
    background: rgba(16,185,129,0.1);
    border-color: rgba(16,185,129,0.3);
    color: var(--green);
  }

  pre {
    background: var(--bg-code);
    padding: 18px 20px;
    overflow-x: auto;
    margin: 0;
  }

  pre code {
    font-family: 'Fira Code', 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.7;
    color: #c9d1d9;
    tab-size: 2;
  }

  .token-comment { color: #6a737d; font-style: italic; }
  .token-keyword { color: #ff7b72; }
  .token-string { color: #a5d6ff; }
  .token-function { color: #d2a8ff; }
  .token-variable { color: #ffa657; }
  .token-number { color: #79c0ff; }
  .token-operator { color: #ff7b72; }
  .token-flag { color: #06b6d4; }
  .token-path { color: #10b981; }
  .token-command { color: #f59e0b; }

  /* ── INLINE CODE ── */
  code:not(pre code) {
    font-family: 'Fira Code', monospace;
    font-size: 12.5px;
    background: rgba(59,130,246,0.1);
    border: 1px solid rgba(59,130,246,0.2);
    color: #93c5fd;
    padding: 1px 6px;
    border-radius: 4px;
  }

  /* ── SUBSECTION HEADING ── */
  .sub-heading {
    font-size: 12px;
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    margin: 20px 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sub-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(6,182,212,0.3), transparent);
  }

  /* ── MODEL TABLE ── */
  .model-table {
    width: 100%;
    border-collapse: collapse;
    margin: 14px 0;
    font-size: 13px;
  }

  .model-table th {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 9px 14px;
    text-align: left;
    background: #0a0d14;
    border-bottom: 1px solid var(--border);
  }

  .model-table td {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(30,45,69,0.5);
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .model-table tr:last-child td { border-bottom: none; }
  .model-table tr:hover td { background: rgba(255,255,255,0.02); }

  .model-table .primary-row td { background: rgba(59,130,246,0.04); }
  .model-table .primary-row td:first-child { border-left: 2px solid var(--blue); }

  .model-badge {
    display: inline-block;
    font-size: 10px;
    font-family: 'Fira Code', monospace;
    padding: 2px 7px;
    border-radius: 3px;
    font-weight: 500;
    margin-left: 6px;
  }

  .badge-primary { background: rgba(59,130,246,0.15); color: var(--blue); border: 1px solid rgba(59,130,246,0.3); }
  .badge-fallback { background: rgba(245,158,11,0.1); color: var(--amber); border: 1px solid rgba(245,158,11,0.25); }

  /* ── WORKFLOW STEPS ── */
  .workflow-steps {
    margin: 16px 0;
    position: relative;
    padding-left: 2px;
  }

  .workflow-step {
    display: flex;
    gap: 16px;
    margin-bottom: 0;
    position: relative;
  }

  .workflow-step::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, var(--border), transparent);
  }

  .workflow-step:last-child::before { display: none; }

  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 6px;
    padding-bottom: 16px;
  }

  .step-circle {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: rgba(6,182,212,0.1);
    border: 1.5px solid rgba(6,182,212,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .step-content {
    padding: 4px 0 20px;
    flex: 1;
    min-width: 0;
  }

  .step-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 14px;
    margin-bottom: 4px;
  }

  .step-detail {
    font-size: 13px;
    color: var(--text-muted);
  }

  .step-params {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .param-tag {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    background: rgba(139,92,246,0.1);
    border: 1px solid rgba(139,92,246,0.2);
    color: #c4b5fd;
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* ── ERROR PROTOCOLS ── */
  .error-item {
    background: rgba(239,68,68,0.05);
    border: 1px solid rgba(239,68,68,0.15);
    border-left: 3px solid rgba(239,68,68,0.5);
    border-radius: 0 8px 8px 0;
    padding: 12px 16px;
    margin-bottom: 10px;
  }

  .error-trigger {
    font-size: 13px;
    font-weight: 500;
    color: #fca5a5;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .error-action {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .error-action code:not(pre code) {
    background: rgba(239,68,68,0.1);
    border-color: rgba(239,68,68,0.2);
    color: #fca5a5;
  }

  /* ── CHECKLIST ── */
  .checklist {
    list-style: none;
    margin: 12px 0;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid transparent;
    margin-bottom: 8px;
    background: rgba(255,255,255,0.01);
    border-color: var(--border);
    transition: background 0.2s;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .checklist-item:hover { background: rgba(255,255,255,0.03); }

  .check-box {
    width: 18px; height: 18px;
    border: 1.5px solid var(--text-muted);
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
  }

  .checklist-item strong { color: var(--text-primary); font-weight: 500; }

  /* ── ALERT BOXES ── */
  .alert {
    border-radius: 8px;
    padding: 12px 16px;
    margin: 14px 0;
    font-size: 13.5px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .alert-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
  .alert-text { color: var(--text-secondary); line-height: 1.6; }
  .alert-text strong { display: block; margin-bottom: 2px; font-size: 13px; }

  .alert-info {
    background: rgba(59,130,246,0.06);
    border: 1px solid rgba(59,130,246,0.2);
  }

  .alert-info .alert-text strong { color: var(--blue); }

  .alert-warning {
    background: rgba(245,158,11,0.06);
    border: 1px solid rgba(245,158,11,0.2);
  }

  .alert-warning .alert-text strong { color: var(--amber); }

  .alert-success {
    background: rgba(16,185,129,0.06);
    border: 1px solid rgba(16,185,129,0.2);
  }

  .alert-success .alert-text strong { color: var(--green); }

  /* ── DIVIDER ── */
  .section-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
    margin: 20px 0;
  }

  /* ── FOOTER ── */
  .directive-footer {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .footer-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-label {
    font-size: 10px;
